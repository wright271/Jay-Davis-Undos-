# The Firebase project is already wired up in src/lib/firebaseConfig.js, so the
# app runs against it with no .env file at all. These variables exist only to
# point a build somewhere else — a second project for testing, say.
#
# A Firebase web config is public by design: it identifies the project and is
# compiled into the bundle every phone downloads. firestore.rules is what
# controls who can write.

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Firestore document id for this tournament. Change it to run a second event
# from the same project without the two sharing scores.
# VITE_TOURNAMENT_ID=default
