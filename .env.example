# The Firebase project is already wired up in src/lib/firebaseConfig.js, so the
# app runs against it with no .env file at all. These variables exist only to
# point a build somewhere else — a second project for testing, say.
#
# A Firebase web config is public by design: it identifies the project and is
# compiled into the bundle every phone downloads. database.rules.json is what
# controls who can write.

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# Realtime Database instance URL — shown at the top of the console's Data tab.
# us-central1 databases use the firebaseio.com form; other regions use
# https://<project>-default-rtdb.<region>.firebasedatabase.app
# VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# VITE_FIREBASE_APP_ID=

# Which tournament node to read. Change it to run a second event from the same
# database without the two sharing scores.
# VITE_TOURNAMENT_ID=default
